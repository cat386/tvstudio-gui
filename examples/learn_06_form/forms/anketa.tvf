{
  "format": "tvstudio-form",
  "version": 1,
  "name": "anketa",
  "title": "Анкета",
  "x": 10,
  "y": 3,
  "w": 56,
  "h": 19,
  "centered": true,
  "palette": "gray",
  "help_ctx": 0,
  "controls": [
    {
      "kind": "input_line",
      "name": "name",
      "x": 14,
      "y": 2,
      "w": 38,
      "h": 1,
      "max_len": 40,
      "scrollbar": false
    },
    {
      "kind": "label",
      "name": "name_label",
      "x": 2,
      "y": 2,
      "w": 11,
      "h": 1,
      "text": "~И~мя:",
      "link": "name",
      "scrollbar": false
    },
    {
      "kind": "input_line",
      "name": "age",
      "x": 14,
      "y": 4,
      "w": 6,
      "h": 1,
      "max_len": 3,
      "validator": "range:1..120",
      "scrollbar": false
    },
    {
      "kind": "label",
      "name": "age_label",
      "x": 2,
      "y": 4,
      "w": 11,
      "h": 1,
      "text": "~В~озраст:",
      "link": "age",
      "scrollbar": false
    },
    {
      "kind": "radio_buttons",
      "name": "drink",
      "x": 3,
      "y": 7,
      "w": 17,
      "h": 3,
      "items": ["~Ч~ай", "~К~офе", "~С~ок"],
      "scrollbar": false
    },
    {
      "kind": "label",
      "name": "drink_label",
      "x": 2,
      "y": 6,
      "w": 11,
      "h": 1,
      "text": "Напиток",
      "link": "drink",
      "scrollbar": false
    },
    {
      "kind": "check_boxes",
      "name": "hobbies",
      "x": 23,
      "y": 7,
      "w": 29,
      "h": 2,
      "items": ["~К~ниги", "С~п~орт", "~М~узыка", "И~г~ры"],
      "scrollbar": false
    },
    {
      "kind": "label",
      "name": "hobbies_label",
      "x": 22,
      "y": 6,
      "w": 13,
      "h": 1,
      "text": "Увлечения",
      "link": "hobbies",
      "scrollbar": false
    },
    {
      "kind": "list_box",
      "name": "city",
      "x": 3,
      "y": 12,
      "w": 18,
      "h": 3,
      "items": ["Москва", "Тула", "Казань", "Тверь", "Сочи", "Омск"],
      "scrollbar": true
    },
    {
      "kind": "label",
      "name": "city_label",
      "x": 2,
      "y": 11,
      "w": 11,
      "h": 1,
      "text": "~Г~ород",
      "link": "city",
      "scrollbar": false
    },
    {
      "kind": "button",
      "name": "ok",
      "x": 30,
      "y": 12,
      "w": 12,
      "h": 2,
      "text": "O~K~",
      "command": "cm::OK",
      "default": true,
      "scrollbar": false
    },
    {
      "kind": "button",
      "name": "cancel",
      "x": 30,
      "y": 15,
      "w": 12,
      "h": 2,
      "text": "Отмена",
      "command": "cm::CANCEL",
      "scrollbar": false
    }
  ]
}
