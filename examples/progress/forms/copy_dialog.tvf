{
  "format": "tvstudio-form",
  "version": 1,
  "name": "copy_dialog",
  "title": "Копирование файлов",
  "x": 10,
  "y": 3,
  "w": 52,
  "h": 12,
  "centered": true,
  "palette": "gray",
  "help_ctx": 0,
  "controls": [
    {
      "kind": "static_text",
      "name": "name",
      "x": 3,
