      "w": 46,
      "h": 1,
      "scrollbar": false
    },
    {
      "kind": "progress_bar",
      "name": "file_bar",
      "x": 3,
      "y": 3,
      "w": 46,
      "h": 1,
      "max": 1,
      "scrollbar": false
    },
    {
      "kind": "static_text",
      "name": "text1",
      "x": 3,
      "y": 5,
      "w": 46,
      "h": 1,
      "text": "Всего:",
      "scrollbar": false
    },
    {
      "kind": "progress_bar",
      "name": "total_bar",
      "x": 3,
      "y": 6,
      "w": 46,
      "h": 1,
      "scrollbar": false
    },
    {
      "kind": "button",
      "name": "cancel",
      "x": 20,
      "y": 8,
      "w": 12,
      "h": 2,
      "text": "Отмена",
